# Get an API key from https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Optional: configure a separate economic calendar provider in src/lib/fundamentals.js.
# Never expose private keys using NEXT_PUBLIC_ variables.

# Paper-trade event-risk guard (timezone-free event times are interpreted as Lagos local time)
NSB_EVENT_BLOCK_BEFORE_MINUTES=60
NSB_EVENT_BLOCK_AFTER_MINUTES=30
